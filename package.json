{
  "name": "@dsh-external/dsh-doctor",
  "description": "DSH environment diagnostic tool: a dsh_doctor tool that checks environment, profile structure, config syntax, bundle dependencies, config mount, port, health, and disk space, returning a structured report with fix hints.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../dsh-visualize/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-tools": "link:../dsh-visualize/node_modules/@deepseek-ai/dsh-tools",
    "@deepseek-ai/schemastery": "3.18.1-rc.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}