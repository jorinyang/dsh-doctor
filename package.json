{
  "name": "@jorinyang/dsh-doctor",
  "description": "DeepSeek Harness diagnostic and repair plugin: dsh_doctor (read-only diagnosis) and dsh_doctor_fix (graded safe/deps/full repair) for startup crashes, broken profiles, and config errors.",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "scripts"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm run typecheck && pnpm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "diagnostic",
    "doctor",
    "repair",
    "cli",
    "agent",
    "dsh-doctor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorinyang/dsh-doctor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../dsh-visualize/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-tools": "link:../dsh-visualize/node_modules/@deepseek-ai/dsh-tools",
    "@deepseek-ai/schemastery": "3.18.1-rc.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "bin": {
    "dsh-doctor": "lib/cli.bundle.js"
  }
}
